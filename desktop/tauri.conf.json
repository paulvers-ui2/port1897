{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuroraVPN",
  "mainBinaryName": "AuroraVPN",
  "version": "0.0.0",
  "identifier": "AuroraVPN",
  "build": {
    "frontendDist": "../ui/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "AuroraVPN contributors",
    "homepage": "https://github.com/paulvers-ui2/port1897",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../ui/engine/fswin.exe": "engine/fswin.exe",
      "../ui/engine/usque.exe": "engine/usque.exe",
      "../ui/engine/usque-LICENSE.md": "engine/usque-LICENSE.md",
      "../ui/engine/wintun.dll": "engine/wintun.dll",
      "../ui/engine/wintun-LICENSE.txt": "engine/wintun-LICENSE.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
