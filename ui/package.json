{
  "name": "port1897",
  "productName": "AuroraVPN",
  "version": "0.1.0",
  "description": "Firewall, encrypted DNS and free VPN for Windows, built on firestack",
  "main": "main.js",
  "license": "MPL-2.0",
  "private": true,
  "author": "AuroraVPN contributors",
  "homepage": "https://github.com/paulvers-ui2/port1897",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux deb --publish never"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "io.github.port1897",
    "productName": "AuroraVPN",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "history-worker.js",
      "renderer/**/*",
      "assets/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "packElevateHelper": false,
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "auroravpn",
      "icon": "build/icon.png",
      "category": "Network",
      "maintainer": "AuroraVPN contributors <noreply@github.com>",
      "synopsis": "Firewall, encrypted DNS and free VPN",
      "description": "AuroraVPN: a firewall, encrypted DNS and free VPN (WARP, WireGuard, MASQUE), built on firestack.",
      "extraResources": [
        {
          "from": "build/linux",
          "to": "linux",
          "filter": [
            "auroravpn.service"
          ]
        }
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "AuroraVPN"
        }
      }
    },
    "deb": {
      "artifactName": "${productName}-${version}-amd64.${ext}",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "iproute2",
        "nftables",
        "systemd"
      ],
      "recommends": [
        "python3"
      ],
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh",
      "fpm": [
        "--before-remove=build/linux/before-remove.sh"
      ],
      "packageName": "auroravpn"
    }
  }
}
